{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Empresa",
  "description": "Schema de contrato para o recurso Empresa",
  "type": "object",
  "properties": {
    "id": { "type": ["string", "null"] },
    "nome": { "type": "string", "maxLength": 100 },
    "cnpj": { "type": ["string", "null"], "maxLength": 18 },
    "setor": { "type": ["string", "null"] },
    "statusAdesaoEsg": { "type": ["string", "null"] },
    "esgRating": { "type": ["object", "null"] },
    "metasSustentabilidade": { "type": "array" },
    "certificacoes": { "type": "array" },
    "dataCadastro": { "type": ["string", "null"] }
  },
  "required": ["nome"]
}
