    "equipamentoId": { "type": ["string", "null"] },
    "tipoRecurso": { "type": ["string", "null"] },
    "dataHora": { "type": ["string", "null"] },
    "consumoKwh": { "type": "number", "minimum": 0 },
    "tempoOciosoMin": { "type": ["integer", "null"], "minimum": 0 },
    "pegadaCarbonoKgCo2e": { "type": ["number", "null"] },
    "telemetriaDetalhada": { "type": ["object", "null"] }
